+package com.kairos.kairosapipostgres.receipt;
+
+import com.kairos.kairosapipostgres.model.User;
+import com.kairos.kairosapipostgres.repository.*;
+import org.junit.jupiter.api.Test;
+import org.springframework.data.redis.core.StringRedisTemplate;
+import org.springframework.data.redis.core.ValueOperations;
+import org.springframework.http.HttpStatus;
+import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
+import org.springframework.security.core.authority.SimpleGrantedAuthority;
+import org.springframework.web.server.ResponseStatusException;
+import java.time.Duration;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class CustomerReceiptControllerTest {
+    private final GeminiReceiptReader reader=mock(GeminiReceiptReader.class);
+    private final UserRepository users=mock(UserRepository.class);
+    private final CustomerRepository customers=mock(CustomerRepository.class);
+    private final StringRedisTemplate redis=mock(StringRedisTemplate.class);
+    private final CustomerReceiptController controller=new CustomerReceiptController(reader,users,customers,redis);
+    private UsernamePasswordAuthenticationToken actor(String role) {
+        return new UsernamePasswordAuthenticationToken("customer@example.invalid","unused",
+            List.of(new SimpleGrantedAuthority("ROLE_"+role)));
+    }
+    private void account() {
+        var user=new User();
+        user.setId(42L);
+        when(users.findByEmail("customer@example.invalid")).thenReturn(Optional.of(user));
+        when(customers.existsByUserId(42L)).thenReturn(true);
+    }
+    @Test
+    void capabilitiesRequireSqlCustomerAndNeverClaimPurchaseSupport() {
+        account();
+        when(reader.configured()).thenReturn(true);
+        var body=controller.capabilities(actor("CUSTOMER")).getBody();
+        assertEquals(true,body.get("photoInterpretation"));
+        assertEquals(false,body.get("purchaseConfirmation"));
+        verifyNoInteractions(redis);
+    }
+    @Test
+    void anonymousEmployeesAndAccountsWithoutCustomerCannotInvokeGemini() {
+        assertThrows(ResponseStatusException.class,()->controller.interpret(null,new CustomerReceiptController.Photo("test")));
+        assertThrows(ResponseStatusException.class,()->controller.interpret(actor("EMPLOYEE"),new CustomerReceiptController.Photo("test")));
+        when(users.findByEmail(anyString())).thenReturn(Optional.empty());
+        assertThrows(ResponseStatusException.class,()->controller.interpret(actor("CUSTOMER"),new CustomerReceiptController.Photo("test")));
+        verifyNoInteractions(reader,redis);
+    }
+    @Test
+    @SuppressWarnings("unchecked")
+    void interpretationUsesAuthenticatedUserForSharedRedisThrottle() {
+        account();
+        ValueOperations<String,String> values=mock(ValueOperations.class);
+        when(redis.opsForValue()).thenReturn(values);
+        when(values.setIfAbsent("kairos:receipt-vision:user:42","1",Duration.ofSeconds(10))).thenReturn(true);
+        when(reader.read(eq("image"),any())).thenAnswer(invocation->{
+            ((Runnable)invocation.getArgument(1)).run();
+            return Map.of("items",List.of(),"source","AI_SUGGESTION_UNVERIFIED");
+        });
+        var response=controller.interpret(actor("CUSTOMER"),new CustomerReceiptController.Photo("image"));
+        assertEquals(HttpStatus.OK,response.getStatusCode());
+        assertEquals("no-store",response.getHeaders().getCacheControl());
+        verify(values).setIfAbsent("kairos:receipt-vision:user:42","1",Duration.ofSeconds(10));
+        verify(customers,never()).save(any());
+        verify(users,never()).save(any());
+    }
+    @Test
+    @SuppressWarnings("unchecked")
+    void cooldownRejectsRepeatedRequests() {
+        account();
+        ValueOperations<String,String> values=mock(ValueOperations.class);
+        when(redis.opsForValue()).thenReturn(values);
+        when(values.setIfAbsent(anyString(),eq("1"),any(Duration.class))).thenReturn(false);
+        when(reader.read(anyString(),any())).thenAnswer(invocation->{
+            ((Runnable)invocation.getArgument(1)).run();
+            return Map.of();
+        });
+        var error=assertThrows(ResponseStatusException.class,
+            ()->controller.interpret(actor("CUSTOMER"),new CustomerReceiptController.Photo("image")));
+        assertEquals(HttpStatus.TOO_MANY_REQUESTS,error.getStatusCode());
+    }
+}
