+package com.kairos.kairosapipostgres.receipt;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfSystemProperty;
+import java.awt.Color;
+import java.awt.Font;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayOutputStream;
+import java.util.Base64;
+import java.util.List;
+import java.util.Map;
+import static org.junit.jupiter.api.Assertions.*;
+
+/** Explicit opt-in: one provider call with a synthetic receipt, never a user's document. */
+class GeminiReceiptLiveTest {
+    @Test
+    @EnabledIfSystemProperty(named="integration.gemini",matches="true")
+    void readsOnlyVisibleSyntheticReceiptItems() throws Exception {
+        var key=System.getenv("GEMINI_API_KEY");
+        assertNotNull(key,"Private key must be provided through environment");
+        var model=System.getenv().getOrDefault("GEMINI_VISION_MODEL","gemini-2.5-flash");
+        var image=new BufferedImage(1100,600,BufferedImage.TYPE_INT_RGB);
+        var graphics=image.createGraphics();
+        graphics.setColor(Color.WHITE);
+        graphics.fillRect(0,0,1100,600);
+        graphics.setColor(Color.BLACK);
+        graphics.setFont(new Font("Monospaced",Font.BOLD,27));
+        String[] lines={"NOTA FISCAL - EXEMPLO FICTICIO PARA TESTE",
+            "ITEM  DESCRICAO        QTD   VL UNIT    VL TOTAL",
+            "001   ARROZ TIPO 1     2 UN    5,00       10,00",
+            "002   FEIJAO          1 UN    8,00        8,00",
+            "TOTAL R$ 18,00"};
+        for (int index=0;index<lines.length;index++) {
+            graphics.drawString(lines[index],25,65+index*75);
+        }
+        graphics.dispose();
+        var bytes=new ByteArrayOutputStream();
+        javax.imageio.ImageIO.write(image,"jpg",bytes);
+        var result=new GeminiReceiptReader(key,model).read(Base64.getEncoder().encodeToString(bytes.toByteArray()),()->{});
+        assertEquals("AI_SUGGESTION_UNVERIFIED",result.get("source"));
+        assertNull(result.get("accessKey"));
+        var items=(List<?>)result.get("items");
+        assertEquals(2,items.size());
+        assertTrue(items.stream().map(item->((Map<?,?>)item).get("description").toString().toUpperCase())
+            .anyMatch(description->description.contains("ARROZ")));
+    }
+}
