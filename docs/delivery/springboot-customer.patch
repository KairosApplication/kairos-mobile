+        String json="{\"candidates\":[{\"finishReason\":\"STOP\",\"content\":{\"parts\":[{\"text\":\"{\\\"accessKey\\\":null,\\\"items\\\":[{\\\"description\\\":\\\"Legível\\\",\\\"quantity\\\":2,\\\"amount\\\":4.50}]}\"}]}}]}";
+        when(response.body()).thenReturn(new ByteArrayInputStream(json.getBytes(java.nio.charset.StandardCharsets.UTF_8)));
+        when(client.send(any(HttpRequest.class),org.mockito.ArgumentMatchers.<HttpResponse.BodyHandler<InputStream>>any())).thenAnswer(invocation -> {
+            HttpRequest request=invocation.getArgument(0);
