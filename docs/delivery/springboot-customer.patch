+package com.kairos.kairosapipostgres.mobile;
+
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.security.access.AccessDeniedException;
+import org.springframework.web.server.ResponseStatusException;
+import org.springframework.http.HttpStatus;
+import com.kairos.kairosapipostgres.service.RestockingService;
+import com.kairos.kairosapipostgres.dto.request.RestockingRequest;
+import java.util.*;
+
+@Service
+public class MobileOperationalService {
+    private final JdbcTemplate db;
+    private final RestockingService restockings;
+    public MobileOperationalService(JdbcTemplate db, RestockingService restockings) {
+        this.db = db;
+        this.restockings = restockings;
+    }
+    public void requireOperator(MobileIdentity actor) {
+        if (!actor.operational()) {
+            throw new AccessDeniedException("Operational employee required");
+        }
+    }
+    public List<Map<String,Object>> shelves(MobileIdentity actor) {
+        requireOperator(actor);
+        return db.queryForList("""
+            SELECT s.id,a.position aisle,sec.name sector FROM shelves s JOIN aisles a ON a.id=s.aisle_id
+            JOIN sectors sec ON sec.id=a.sector_id WHERE sec.company_id=?
+            AND (? OR EXISTS(SELECT 1 FROM shelf_employees se WHERE se.shelf_id=s.id AND se.employee_id=?)
+            OR EXISTS(SELECT 1 FROM employee_aisles ea WHERE ea.aisle_id=a.id AND ea.employee_id=?))
+            ORDER BY s.id
+            """,actor.companyId(),"MANAGER".equals(actor.role()),actor.employeeId(),actor.employeeId());
+    }
+    public void requireShelf(MobileIdentity actor, long shelf) {
+        if (shelves(actor).stream().noneMatch(s -> ((Number)s.get("id")).longValue()==shelf)) {
+            throw new AccessDeniedException("Shelf outside assigned area");
+        }
+    }
+    public Map<String,Object> catalog(MobileIdentity actor) {
+        var shelves = shelves(actor);
+        var inventories = db.queryForList("""
+            SELECT i.id,sec.name sector FROM inventories i LEFT JOIN sectors sec ON sec.id=i.sector_id
+            WHERE i.company_id=? AND (? OR EXISTS(SELECT 1 FROM inventory_employees ie
+            WHERE ie.inventory_id=i.id AND ie.employee_id=?)) ORDER BY i.id
+            """,actor.companyId(),"MANAGER".equals(actor.role()),actor.employeeId());
+        var balances = db.queryForList("""
+            SELECT pi.inventory_id,pi.product_id,pi.product_quantity FROM product_inventories pi
+            JOIN inventories i ON i.id=pi.inventory_id JOIN products p ON p.id=pi.product_id
+            WHERE i.company_id=? AND p.company_id=? AND (? OR EXISTS(
+            SELECT 1 FROM inventory_employees ie WHERE ie.inventory_id=i.id AND ie.employee_id=?))
+            """,actor.companyId(),actor.companyId(),"MANAGER".equals(actor.role()),actor.employeeId());
+        return Map.of("shelves",shelves,"inventories",inventories,"balances",balances,"products",
+            db.queryForList("SELECT id,name,COALESCE(brand,'') brand FROM products WHERE company_id=? ORDER BY name",actor.companyId()));
+    }
+    public List<Map<String,Object>> alerts(MobileIdentity actor) {
+        requireOperator(actor);
+        var ids = shelves(actor).stream().map(s -> ((Number)s.get("id")).longValue()).toList();
+        var rows = db.queryForList("""
+            SELECT al.id,al.shelf_id,al.product_id,al.description,al.status,al.stockout_date,
+            p.name product_name,ps.product_quantity shelf_quantity,
+            r.id report_id,r.problem_type,r.description report_description,r.created_at reported_at
+            FROM alerts al LEFT JOIN products p ON p.id=al.product_id
+            LEFT JOIN shelves sh ON sh.id=al.shelf_id LEFT JOIN aisles a ON a.id=sh.aisle_id
+            LEFT JOIN sectors sec ON sec.id=a.sector_id
+            LEFT JOIN product_shelves ps ON ps.product_id=al.product_id AND ps.shelf_id=al.shelf_id
+            LEFT JOIN customer_damage_reports r ON r.alert_id=al.id
+            WHERE al.status='OPEN' AND COALESCE(al.company_id,sec.company_id)=? ORDER BY al.id DESC
+            """,actor.companyId());
+        rows.forEach(row -> {
+            if (row.get("reported_at") instanceof java.sql.Timestamp time) {
+                row.put("reported_at",time.toInstant().toString());
+            }
+            if (row.get("stockout_date")!=null) {
+                row.put("stockout_date",row.get("stockout_date").toString());
+            }
+        });
+        return rows.stream().filter(r -> r.get("shelf_id")==null ? "MANAGER".equals(actor.role())
+            : ids.contains(((Number)r.get("shelf_id")).longValue())).toList();
+    }
+    @Transactional
+    public void resolve(MobileIdentity actor,long alertId) {
+        if (alerts(actor).stream().noneMatch(a -> ((Number)a.get("id")).longValue()==alertId)) {
+            throw new AccessDeniedException("Alert outside assigned area");
+        }
+        db.update("UPDATE alerts SET status='RESOLVED',resolution_date=CURRENT_TIMESTAMP WHERE id=? AND status='OPEN'",alertId);
+    }
+    public Map<String,Object> summary(MobileIdentity actor) {
+        requireOperator(actor);
+        return db.queryForMap("""
+            SELECT COUNT(*) restocks,COALESCE(SUM(qnt_avarias),0) damages FROM restockings
+            WHERE employee_id=?
+            """,actor.employeeId());
+    }
+    public record Restock(UUID commandId,long shelfId,long inventoryId,long productId,
+                          int restockedQuantity,int damagedQuantity) { }
+    @Transactional
+    public Map<String,Object> confirm(MobileIdentity actor,Restock request) {
+        requireOperator(actor);
+        if (request.commandId()==null || request.restockedQuantity()<=0 || request.damagedQuantity()<0
+            || request.damagedQuantity()>request.restockedQuantity()) {
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST);
+        }
+        db.queryForList("SELECT firebase_uid FROM mobile_identities WHERE firebase_uid=? FOR UPDATE",actor.uid());
+        var previous = db.queryForList("SELECT firebase_uid,payload,restocking_id FROM mobile_restocking_commands WHERE command_id=?",request.commandId());
+        if (!previous.isEmpty()) {
+            var row = previous.getFirst();
+            if (!actor.uid().equals(row.get("firebase_uid")) || !request.toString().equals(row.get("payload"))) {
+                throw new ResponseStatusException(HttpStatus.CONFLICT);
+            }
+            return Map.of("id",row.get("restocking_id"));
+        }
+        requireShelf(actor,request.shelfId());
+        var permitted = (List<?>)catalog(actor).get("inventories");
+        if (permitted.stream().noneMatch(i -> ((Number)((Map<?,?>)i).get("id")).longValue()==request.inventoryId())) {
+            throw new AccessDeniedException("Inventory not assigned");
+        }
+        var result = restockings.save(new RestockingRequest(request.inventoryId(),actor.employeeId(),request.shelfId(),
+            request.productId(),request.restockedQuantity(),request.damagedQuantity()));
+        db.update("INSERT INTO mobile_restocking_commands(command_id,firebase_uid,payload,restocking_id) VALUES (?,?,?,?)",
+            request.commandId(),actor.uid(),request.toString(),result.id());
+        return Map.of("id",result.id());
+    }
+    @Transactional
+    public List<Map<String,Object>> batch(MobileIdentity actor,List<Restock> items) {
+        if (items==null || items.isEmpty() || items.size()>25
+            || items.stream().map(Restock::commandId).distinct().count()!=items.size()) {
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST);
+        }
+        return items.stream().map(item -> confirm(actor,item)).toList();
+    }
+}
