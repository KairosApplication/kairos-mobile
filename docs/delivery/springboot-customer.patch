+package com.kairos.kairosapipostgres.mobile;
+
+import org.junit.jupiter.api.*;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.security.oauth2.jwt.*;
+import org.springframework.test.web.servlet.MockMvc;
+import java.time.Instant;
+import java.util.Map;
+import static org.mockito.Mockito.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class MobileSecurityIntegrationTest {
+    @Autowired private MockMvc mvc;
+    @MockitoBean(name="mobileFirebaseDecoder") private JwtDecoder decoder;
+    @MockitoBean private MobileIdentityService identities;
+    @MockitoBean private CustomerMobileService customers;
+    @BeforeEach
+    void verifiedIdentityFixture() {
+        var jwt=Jwt.withTokenValue("firebase-test").header("alg","RS256").subject("uid-customer")
+            .claim("email","a@example.com").issuedAt(Instant.now()).expiresAt(Instant.now().plusSeconds(60)).build();
+        when(decoder.decode("firebase-test")).thenReturn(jwt);
+        when(decoder.decode("forged")).thenThrow(new BadJwtException("Invalid signature"));
+        var customer=new MobileIdentity("uid-customer","a@example.com",1L,null,1L,1L,"CUSTOMER","A","a@example.com");
+        when(identities.resolve("uid-customer","a@example.com")).thenReturn(customer);
+        when(customers.home(any())).thenReturn(Map.of("companyId",1));
+    }
+    @Test
+    void customerCanOpenOwnHomeButCannotAccessOperationalOrAdministrativeRoutes() throws Exception {
+        mvc.perform(get("/api/v1/mobile/customer/home").header("Authorization","Bearer firebase-test"))
+            .andExpect(status().isOk()).andExpect(jsonPath("$.companyId").value(1));
+        mvc.perform(get("/api/v1/mobile/catalog").header("Authorization","Bearer firebase-test"))
+            .andExpect(status().isForbidden());
+        mvc.perform(get("/api/v1/mobile/alerts").header("Authorization","Bearer firebase-test"))
+            .andExpect(status().isForbidden());
+        mvc.perform(get("/api/v1/employees/list").header("Authorization","Bearer firebase-test")
+            .header("X-Kairos-Identity","firebase")).andExpect(status().is4xxClientError());
+        verify(customers,times(1)).home(any());
+    }
+    @Test
+    void anonymousAndForgedTokensAreRejected() throws Exception {
+        mvc.perform(get("/api/v1/mobile/customer/home")).andExpect(status().isUnauthorized());
+        mvc.perform(get("/api/v1/mobile/customer/home").header("Authorization","Bearer forged"))
+            .andExpect(status().isUnauthorized());
+        verifyNoInteractions(customers);
+    }
+}
diff --git a/src/test/java/com/kairos/kairosapipostgres/mobile/NfceKeyTest.java b/src/test/java/com/kairos/kairosapipostgres/mobile/NfceKeyTest.java
