+package com.kairos.kairosapipostgres.mobile;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.core.annotation.Order;
+import org.springframework.http.HttpMethod;
+import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
+import org.springframework.security.config.annotation.web.builders.HttpSecurity;
+import org.springframework.security.config.annotation.web.configurers.AbstractHttpConfigurer;
+import org.springframework.security.config.http.SessionCreationPolicy;
+import org.springframework.security.core.authority.SimpleGrantedAuthority;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.security.oauth2.core.*;
+import org.springframework.security.oauth2.jose.jws.SignatureAlgorithm;
+import org.springframework.security.oauth2.jwt.*;
+import org.springframework.security.web.SecurityFilterChain;
+import org.springframework.security.web.authentication.AnonymousAuthenticationFilter;
+import org.springframework.web.filter.OncePerRequestFilter;
+import jakarta.servlet.*;
+import jakarta.servlet.http.*;
+import java.io.IOException;
+import java.util.List;
+
+@Configuration
+public class MobileSecurityConfig {
+    @Bean("mobileFirebaseDecoder")
+    JwtDecoder firebaseDecoder(@Value("${FIREBASE_PROJECT_ID:}") String project) {
+        if (project.isBlank()) {
+            return token -> { throw new JwtException("Firebase project not configured"); };
+        }
+        NimbusJwtDecoder decoder = NimbusJwtDecoder.withJwkSetUri(
+            "https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com")
+            .jwsAlgorithm(SignatureAlgorithm.RS256).build();
+        OAuth2TokenValidator<Jwt> required = jwt -> jwt.getAudience().contains(project)
+            && jwt.getSubject() != null && !jwt.getSubject().isBlank() && jwt.getSubject().length() <= 128
+            && jwt.getClaimAsString("email") != null && jwt.getIssuedAt() != null
+            && !jwt.getIssuedAt().isAfter(java.time.Instant.now()) && jwt.getExpiresAt() != null
+            ? OAuth2TokenValidatorResult.success()
+            : OAuth2TokenValidatorResult.failure(new OAuth2Error("invalid_token"));
+        decoder.setJwtValidator(new DelegatingOAuth2TokenValidator<>(
+            JwtValidators.createDefaultWithIssuer("https://securetoken.google.com/" + project), required));
+        return decoder;
+    }
+
+    @Bean
+    @Order(1)
+    SecurityFilterChain mobileChain(HttpSecurity http, MobileIdentityService identities,
+        @org.springframework.beans.factory.annotation.Qualifier("mobileFirebaseDecoder") JwtDecoder decoder) throws Exception {
+        var filter = new OncePerRequestFilter() {
+            @Override
+            protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain chain)
+                    throws ServletException, IOException {
+                String authorization = request.getHeader("Authorization");
+                if (authorization != null) {
+                    try {
+                        if (!authorization.startsWith("Bearer ")) {
+                            response.setStatus(401);
+                            return;
+                        }
+                        Jwt jwt = decoder.decode(authorization.substring(7));
+                        MobileIdentity identity = identities.resolve(jwt.getSubject(), jwt.getClaimAsString("email"));
+                        var authorities = identity.operational()
+                            ? List.of(new SimpleGrantedAuthority("ROLE_EMPLOYEE"), new SimpleGrantedAuthority("ROLE_" + identity.role()))
+                            : List.of(new SimpleGrantedAuthority("ROLE_" + identity.role()));
+                        var context = SecurityContextHolder.createEmptyContext();
+                        context.setAuthentication(new UsernamePasswordAuthenticationToken(identity, null, authorities));
+                        SecurityContextHolder.setContext(context);
+                    } catch (JwtException | IllegalArgumentException error) {
+                        response.setStatus(401);
+                        return;
+                    } catch (org.springframework.dao.DataAccessException error) {
+                        response.setStatus(503);
+                        return;
+                    }
+                }
+                response.setHeader("Cache-Control", "no-store");
+                chain.doFilter(request, response);
+            }
+        };
+        http.securityMatcher(request -> request.getRequestURI().startsWith("/api/v1/mobile/")
+                || ("firebase".equals(request.getHeader("X-Kairos-Identity"))
+                    && request.getRequestURI().equals("/api/v1/restockings/week")))
+            .csrf(AbstractHttpConfigurer::disable)
+            .sessionManagement(session -> session.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
+            .requestCache(AbstractHttpConfigurer::disable)
+            .authorizeHttpRequests(auth -> auth
+                .requestMatchers("/api/v1/mobile/session", "/api/v1/mobile/link", "/api/v1/mobile/registration").authenticated()
+                .requestMatchers("/api/v1/mobile/customer/**").hasRole("CUSTOMER")
+                .requestMatchers("/api/v1/mobile/**", "/api/v1/restockings/week").hasAnyRole("STOCKER","MANAGER")
+                .anyRequest().denyAll())
+            .exceptionHandling(errors -> errors.authenticationEntryPoint((r,s,e) -> s.setStatus(401))
+                .accessDeniedHandler((r,s,e) -> s.setStatus(403)))
+            .addFilterBefore(filter, AnonymousAuthenticationFilter.class);
+        return http.build();
+    }
+}
