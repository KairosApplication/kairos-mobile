+import org.flywaydb.core.Flyway;
+import com.kairos.kairosapipostgres.service.CustomerService;
+import com.kairos.kairosapipostgres.service.RestockingService;
+import com.kairos.kairosapipostgres.repository.ProductRepository;
+import java.util.*;
+import java.math.BigDecimal;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@EnabledIfSystemProperty(named="integration.customer",matches="true")
+@TestInstance(TestInstance.Lifecycle.PER_CLASS)
+class CustomerPostgresIntegrationTest {
+    private GenericContainer<?> postgres;
+    private JdbcTemplate db;
+    private TransactionTemplate tx;
+    private CustomerMobileService service;
+    private MobileOperationalService operations;
+    private MobileIdentityService identities;
+    private final MobileIdentity customer=new MobileIdentity("customer-a","a@example.com",1L,null,1L,1L,"CUSTOMER","Market A","a@example.com");
+    private final MobileIdentity stocker=new MobileIdentity("stock-a","stock@example.com",3L,1L,null,1L,"STOCKER","Market A","stock@example.com");
+    private final MobileIdentity otherStocker=new MobileIdentity("stock-b","other@example.com",4L,2L,null,2L,"STOCKER","Market B","other@example.com");
+
+    @BeforeAll
+    void startDiscardableDatabaseAndMigrate() {
+        postgres=new GenericContainer<>(DockerImageName.parse("postgres:17-alpine"))
+            .withEnv("POSTGRES_USER","test").withEnv("POSTGRES_PASSWORD",UUID.randomUUID().toString())
+            .withEnv("POSTGRES_DB","customer_test").withExposedPorts(5432)
+            .waitingFor(org.testcontainers.containers.wait.strategy.Wait.forListeningPort());
+        postgres.start();
+        String password=postgres.getEnvMap().get("POSTGRES_PASSWORD");
+        var source=new DriverManagerDataSource("jdbc:postgresql://"+postgres.getHost()+":"+postgres.getMappedPort(5432)+"/customer_test","test",password);
+        Flyway.configure().dataSource(source).load().migrate();
+        db=new JdbcTemplate(source);
+        tx=new TransactionTemplate(new DataSourceTransactionManager(source));
+        var recommendations=mock(CustomerService.class);
+        service=new CustomerMobileService(db,recommendations);
+        operations=new MobileOperationalService(db,mock(RestockingService.class));
+        identities=new MobileIdentityService(db,PasswordEncoderFactories.createDelegatingPasswordEncoder(),1);
+    }
+    @BeforeEach
+    void fixturesOnlyInDiscardableDatabase() {
+        db.execute("TRUNCATE companies,users RESTART IDENTITY CASCADE");
+        db.execute("""
+            INSERT INTO companies(name,cnpj,email,plan) VALUES
+            ('Market A','12345678000195','a@market.test','test'),('Market B','98765432000198','b@market.test','test');
+            INSERT INTO users(name,last_name,birth_date,cpf,email,password) VALUES
+            ('A','Test','2000-01-01','10000000001','a@example.com','disabled'),
+            ('B','Test','2000-01-01','10000000002','b@example.com','disabled'),
+            ('Stock','Test','2000-01-01','10000000003','stock@example.com','disabled'),
+            ('Other','Test','2000-01-01','10000000004','other@example.com','disabled');
+            INSERT INTO customers(users_id,company_id) VALUES (1,1),(2,2);
+            INSERT INTO employees(users_id,company_id,position) VALUES (3,1,'STOCKER'),(4,2,'STOCKER');
+            INSERT INTO sectors(company_id,name,type) VALUES (1,'Food','TEST'),(2,'Other','TEST');
+            INSERT INTO aisles(sector_id,position) VALUES (1,1),(2,1);
+            INSERT INTO shelves(aisle_id,maximum_capacity) VALUES (1,100),(2,100);
+            INSERT INTO shelf_employees(shelf_id,employee_id) VALUES (1,1),(2,2);
+            INSERT INTO categories(company_id,category) VALUES (1,'Food'),(2,'Other');
+            INSERT INTO products(company_id,name,brand,price,category_id) VALUES
+            (1,'Rice','Test',CAST(10 AS money),1),(1,'Beans','Test',CAST(5 AS money),1),(2,'Other','Test',CAST(3 AS money),2);
+            INSERT INTO product_shelves(product_id,shelf_id,product_quantity) VALUES (1,1,10),(2,1,10),(3,2,10);
+            INSERT INTO mobile_identities(firebase_uid,user_id) VALUES ('customer-a',1),('stock-a',3),('stock-b',4);
+            """);
+    }
+    private UsernamePasswordAuthenticationToken auth(MobileIdentity actor) {
+        return new UsernamePasswordAuthenticationToken(actor,null,List.of(new SimpleGrantedAuthority("ROLE_"+actor.role())));
+    }
+    @Test
+    void receiptConfirmationIsIdempotentAndFeedsExistingRecommendationQuery() throws Exception {
+        var request=new CustomerMobileService.Receipt(NfceKeyTest.key("12345678000195"),
+            List.of(new CustomerMobileService.Item(1,2,new BigDecimal("20.00"))));
+        var first=tx.execute(s->service.receipt(customer,request));
+        var retry=tx.execute(s->service.receipt(customer,request));
+        assertEquals(first,retry);
+        assertEquals(1,db.queryForObject("SELECT COUNT(*) FROM purchases",Integer.class));
+        assertEquals(1,service.history(customer).size());
+        String sql=ProductRepository.class.getMethod("recommendForCustomer",Long.class,int.class)
+            .getAnnotation(org.springframework.data.jpa.repository.Query.class).value();
+        var recommended=new NamedParameterJdbcTemplate(db).queryForList(sql,Map.of("customerId",1L,"limit",20));
+        assertEquals(2L,((Number)recommended.getFirst().get("productId")).longValue());
+        assertThrows(org.springframework.web.server.ResponseStatusException.class,()->tx.execute(s->service.receipt(customer,
+            new CustomerMobileService.Receipt(request.qrCode(),List.of(new CustomerMobileService.Item(2,1,new BigDecimal("5.00")))))));
+        assertEquals(10,db.queryForObject("SELECT product_quantity FROM product_shelves WHERE id=1",Integer.class));
+    }
+    @Test
+    void reportTriggerCreatesOneScopedAlertAndResolutionReachesCustomer() {
+        var request=new CustomerMobileService.Damage(UUID.randomUUID(),1,1L,"EXPIRED","Data vencida");
+        var result=tx.execute(s->service.damage(customer,request));
+        assertEquals(result,tx.execute(s->service.damage(customer,request)));
+        assertEquals(1,db.queryForObject("SELECT COUNT(*) FROM alerts",Integer.class));
+        assertEquals(1,operations.alerts(stocker).size());
+        assertTrue(operations.alerts(otherStocker).isEmpty());
+        assertEquals("EXPIRED",operations.alerts(stocker).getFirst().get("problem_type"));
+        long alert=((Number)operations.alerts(stocker).getFirst().get("id")).longValue();
+        tx.executeWithoutResult(s->operations.resolve(stocker,alert));
+        assertEquals("RESOLVED",service.reports(customer).getFirst().get("status"));
+        assertEquals(10,db.queryForObject("SELECT product_quantity FROM product_shelves WHERE id=1",Integer.class));
+    }
+    @Test
+    void favoritesSurviveServiceRecreationAndForeignCompanyWritesAreRejected() {
+        tx.executeWithoutResult(s->service.favorite(customer,1,true));
+        var recommendationService=mock(CustomerService.class);
+        when(recommendationService.recommendProducts(anyLong(),anyInt(),any())).thenReturn(List.of());
+        var reloaded=new CustomerMobileService(db,recommendationService);
+        var products=(List<?>)reloaded.home(auth(customer)).get("products");
+        assertTrue(products.stream().anyMatch(p -> Boolean.TRUE.equals(((Map<?,?>)p).get("favorite"))));
+        assertEquals(1,db.queryForObject("SELECT COUNT(*) FROM customer_favorites WHERE customer_id=1 AND product_id=1",Integer.class));
+        assertThrows(AccessDeniedException.class,()->reloaded.favorite(customer,3,true));
+        assertThrows(AccessDeniedException.class,()->service.customer(auth(stocker)));
+        assertThrows(AccessDeniedException.class,()->operations.catalog(customer));
+        assertThrows(AccessDeniedException.class,()->tx.execute(s->service.damage(customer,
+            new CustomerMobileService.Damage(UUID.randomUUID(),1,2L,"OTHER",""))));
+        assertEquals(0,db.queryForObject("SELECT COUNT(*) FROM customer_damage_reports",Integer.class));
+    }
+    @Test
+    void databaseTriggerRejectsScopeViolationAndRollsBackTheAlert() {
+        assertThrows(org.springframework.dao.DataIntegrityViolationException.class,()->tx.execute(s->db.update("""
+            INSERT INTO customer_damage_reports(id,command_id,customer_id,company_id,product_id,shelf_id,problem_type)
+            VALUES (?,?,1,1,3,2,'OTHER')
+            """,UUID.randomUUID(),UUID.randomUUID())));
+        assertEquals(0,db.queryForObject("SELECT COUNT(*) FROM alerts",Integer.class));
+        assertEquals(0,db.queryForObject("SELECT COUNT(*) FROM customer_damage_reports",Integer.class));
+    }
+    @Test
+    void resolvesIdentityFromImmutableUidAndKeepsBusinessRoles() {
+        assertEquals(1L,identities.resolve("customer-a","changed@example.com").customerId());
+        assertEquals("STOCKER",identities.resolve("stock-a","changed@example.com").role());
+        assertEquals("UNLINKED",identities.resolve("unknown","a@example.com").role());
+    }
+    @AfterAll
+    void stopOnlyThisTestContainer() {
+        if (postgres!=null) {
+            postgres.stop();
+        }
+    }
+}
