+package com.kairos.kairosapipostgres.mobile;
+
+import java.net.URI;
+import java.net.URLDecoder;
+import java.nio.charset.StandardCharsets;
+import java.util.Set;
+
+// No network access: public consultation may require CAPTCHA; items are always confirmed by the customer.
+public final class NfceKey {
+    private NfceKey() { }
+    private static final Set<String> HOSTS=Set.of("www.nfce.fazenda.sp.gov.br","nfce.fazenda.sp.gov.br",
+        "www.fazenda.pr.gov.br","nfce.fazenda.pr.gov.br","www.sefaz.rs.gov.br","www.sefaz.mt.gov.br",
+        "nfce.sefaz.pe.gov.br","nfce.fazenda.mg.gov.br");
+    public static String parse(String value) {
+        if (value==null || value.length()>4096) {
+            throw new IllegalArgumentException("QR Code inválido");
+        }
+        String key=value.trim();
+        if (!key.matches("[0-9]{44}")) {
+            URI uri=URI.create(key);
+            if (uri.getScheme()==null || uri.getHost()==null || !Set.of("https","http").contains(uri.getScheme()) || !HOSTS.contains(uri.getHost())
+                || uri.getUserInfo()!=null || uri.getPort()!=-1 || uri.getFragment()!=null || uri.getRawQuery()==null) {
+                throw new IllegalArgumentException("Endereço fiscal não autorizado. Informe a chave de acesso.");
+            }
+            String parameter=null;
+            for (String part:uri.getRawQuery().split("&")) {
+                String[] pair=part.split("=",2);
+                if (pair.length==2 && pair[0].equals("p")) {
+                    if (parameter!=null) {
+                        throw new IllegalArgumentException("Parâmetro duplicado");
+                    }
+                    parameter=URLDecoder.decode(pair[1],StandardCharsets.UTF_8);
+                }
+            }
+            if (parameter==null) {
+                throw new IllegalArgumentException("Chave ausente");
+            }
+            key=parameter.split("\\|",-1)[0];
+        }
+        if (!key.matches("[0-9]{44}") || !"65".equals(key.substring(20,22))) {
+            throw new IllegalArgumentException("Informe uma chave NFC-e modelo 65 válida");
+        }
+        int sum=0;
+        int weight=2;
+        for (int i=42;i>=0;i--) {
+            sum+=(key.charAt(i)-'0')*weight;
+            weight=weight==9?2:weight+1;
+        }
+        int digit=11-sum%11;
+        if (digit>=10) {
+            digit=0;
+        }
+        if (digit!=key.charAt(43)-'0') {
+            throw new IllegalArgumentException("Dígito verificador inválido");
+        }
+        return key;
+    }
+}
