+package com.kairos.kairosapipostgres.mobile;
+
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Service;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.security.crypto.password.PasswordEncoder;
+import org.springframework.security.access.AccessDeniedException;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+import java.time.LocalDate;
+import java.util.Map;
+import java.util.UUID;
+
+@Service
+public class MobileIdentityService {
+    private final JdbcTemplate db;
+    private final PasswordEncoder passwords;
+    private final long publicCompany;
+
+    public MobileIdentityService(JdbcTemplate db, PasswordEncoder passwords,
+                                 @Value("${MOBILE_PUBLIC_COMPANY_ID:0}") long publicCompany) {
+        this.db = db;
+        this.passwords = passwords;
+        this.publicCompany = publicCompany;
+    }
+
+    public MobileIdentity resolve(String uid, String email) {
+        var rows = db.query("""
+            SELECT u.id,u.email,e.id employee_id,c.id customer_id,
+              COALESCE(e.company_id,c.company_id) company_id,
+              COALESCE(e.position,CASE WHEN c.id IS NOT NULL THEN 'CUSTOMER' END) role,co.name company_name
+            FROM mobile_identities m JOIN users u ON u.id=m.user_id
+            LEFT JOIN employees e ON e.users_id=u.id LEFT JOIN customers c ON c.users_id=u.id
+            LEFT JOIN companies co ON co.id=COALESCE(e.company_id,c.company_id)
+            WHERE m.firebase_uid=?
+            """, (rs,n) -> new MobileIdentity(uid,email,rs.getLong("id"),
+                number(rs.getObject("employee_id")),number(rs.getObject("customer_id")),
+                number(rs.getObject("company_id")),rs.getString("role"),rs.getString("company_name"),rs.getString("email")),uid);
+        return rows.isEmpty() ? new MobileIdentity(uid,email,null,null,null,null,"UNLINKED","",null) : rows.getFirst();
+    }
+
+    // Independent transaction: wrong-password counters must survive rejected link requests.
+    @Transactional(noRollbackFor = ResponseStatusException.class)
+    public MobileIdentity link(MobileIdentity actor, String password) {
+        if (actor.userId() != null) {
+            return actor;
+        }
+        db.update("INSERT INTO mobile_link_attempts(firebase_uid) VALUES (?) ON CONFLICT DO NOTHING",actor.uid());
+        var attempt = db.queryForMap("SELECT failures,window_start < CURRENT_TIMESTAMP - INTERVAL '15 minutes' expired FROM mobile_link_attempts WHERE firebase_uid=? FOR UPDATE",actor.uid());
+        if (Boolean.TRUE.equals(attempt.get("expired"))) {
+            db.update("UPDATE mobile_link_attempts SET failures=0,window_start=CURRENT_TIMESTAMP WHERE firebase_uid=?",actor.uid());
+        } else if (((Number)attempt.get("failures")).intValue() >= 5) {
+            throw new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS);
+        }
+        var rows = db.queryForList("SELECT id,password FROM users WHERE LOWER(email)=LOWER(?)",actor.firebaseEmail());
+        boolean matches = false;
+        if (rows.size() == 1 && password != null && password.length() <= 255) {
+            try {
+                matches = passwords.matches(password, rows.getFirst().get("password").toString());
+            } catch (IllegalArgumentException ignored) {
+                matches = false;
+            }
+        }
+        if (!matches) {
+            db.update("UPDATE mobile_link_attempts SET failures=failures+1 WHERE firebase_uid=?",actor.uid());
+            throw new ResponseStatusException(HttpStatus.FORBIDDEN,"Vínculo não autorizado");
+        }
+        long id = ((Number)rows.getFirst().get("id")).longValue();
+        if (!db.queryForList("SELECT firebase_uid FROM mobile_identities WHERE user_id=?",id).isEmpty()) {
+            throw new ResponseStatusException(HttpStatus.CONFLICT,"Conta já vinculada");
+        }
+        db.update("INSERT INTO mobile_identities(firebase_uid,user_id) VALUES (?,?)",actor.uid(),id);
+        return resolve(actor.uid(),actor.firebaseEmail());
+    }
+
+    @Transactional
+    public MobileIdentity register(MobileIdentity actor, String name, String lastName, LocalDate birthDate, String cpf) {
+        if (actor.userId() != null) {
+            return actor;
+        }
+        if (publicCompany <= 0 || db.queryForList("SELECT id FROM companies WHERE id=?",publicCompany).isEmpty()) {
+            throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE,"Cadastro de clientes não configurado");
+        }
+        var id = db.queryForObject("""
+            INSERT INTO users(name,last_name,birth_date,cpf,email,password) VALUES (?,?,?,?,?,?) RETURNING id
+            """,Long.class,name.trim(),lastName.trim(),birthDate,cpf.replaceAll("[^0-9]",""),actor.firebaseEmail(),passwords.encode(UUID.randomUUID().toString()));
+        db.update("INSERT INTO customers(users_id,company_id) VALUES (?,?)",id,publicCompany);
+        db.update("INSERT INTO mobile_identities(firebase_uid,user_id) VALUES (?,?)",actor.uid(),id);
+        return resolve(actor.uid(),actor.firebaseEmail());
+    }
+
+    public static MobileIdentity actor(org.springframework.security.core.Authentication auth) {
+        if (auth == null || !(auth.getPrincipal() instanceof MobileIdentity identity)) {
+            throw new AccessDeniedException("Mobile identity required");
+        }
+        return identity;
+    }
+    private static Long number(Object value) {
+        return value==null?null:((Number)value).longValue();
+    }
+}
