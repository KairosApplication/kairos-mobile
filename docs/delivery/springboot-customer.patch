+package com.kairos.kairosapipostgres.mobile;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NfceKeyTest {
+    static String key(String cnpj) {
+        String base="352611"+cnpj+"65001000000123112345678";
+        int sum=0;
+        int weight=2;
+        for (int i=42;i>=0;i--) {
+            sum+=(base.charAt(i)-'0')*weight;
+            weight=weight==9?2:weight+1;
+        }
+        int digit=11-sum%11;
+        return base+(digit>=10?0:digit);
+    }
+    @Test
+    void acceptsAccessKeyAndOfficialEncodedQrWithoutNetworkRequests() {
+        String key=key("12345678000195");
+        assertEquals(44,key.length());
+        assertEquals(key,NfceKey.parse(key));
+        assertEquals(key,NfceKey.parse("https://www.nfce.fazenda.sp.gov.br/NFCeConsultaPublica/Paginas/ConsultaQRCode.aspx?p="+key+"%7C2%7C1%7C1%7CABC"));
+    }
+    @Test
+    void rejectsMaliciousOriginsDuplicateParametersInvalidModelsAndDigits() {
+        String key=key("12345678000195");
+        for (String value:java.util.List.of("http://127.0.0.1/?p="+key,"file:///tmp/key",
+            "https://www.nfce.fazenda.sp.gov.br.evil.example/?p="+key,
+            "https://user@www.nfce.fazenda.sp.gov.br/?p="+key,
+            "https://www.nfce.fazenda.sp.gov.br:8000/?p="+key,
+            "https://www.nfce.fazenda.sp.gov.br/?p="+key+"&p="+key,
+            key.substring(0,43)+(key.endsWith("0")?"1":"0"),"123")) {
+            assertThrows(IllegalArgumentException.class,()->NfceKey.parse(value));
+        }
+    }
+}
