@@ -0,0 +1,15 @@
+package com.kairos.kairosapipostgres.mobile;
+
+import java.security.Principal;
+
+public record MobileIdentity(String uid, String firebaseEmail, Long userId, Long employeeId,
+                             Long customerId, Long companyId, String role, String companyName,
+                             String databaseEmail) implements Principal {
+    @Override
+    public String getName() {
+        return databaseEmail == null ? uid : databaseEmail;
+    }
+    public boolean operational() {
+        return employeeId != null && ("STOCKER".equals(role) || "MANAGER".equals(role));
+    }
+}
