+CREATE TABLE customer_favorites (
+    customer_id integer NOT NULL REFERENCES customers(id),
+    product_id integer NOT NULL REFERENCES products(id),
+    created_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    PRIMARY KEY(customer_id, product_id)
+);
+CREATE TABLE customer_receipts (
+    id uuid PRIMARY KEY,
+    customer_id integer NOT NULL REFERENCES customers(id),
+    company_id integer NOT NULL REFERENCES companies(id),
+    access_key varchar(44) NOT NULL,
+    purchase_id integer NOT NULL UNIQUE REFERENCES purchases(id),
+    source varchar(30) NOT NULL CHECK(source = 'CUSTOMER_CONFIRMED'),
+    confirmed_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    UNIQUE(company_id, access_key)
+);
+CREATE TABLE customer_offers (
+    id bigserial PRIMARY KEY,
+    product_id integer NOT NULL REFERENCES products(id),
+    kind varchar(20) NOT NULL CHECK(kind IN ('PROMOTION','CLEARANCE')),
+    description varchar(200) NOT NULL,
+    discount_percentage numeric(5,2) NOT NULL CHECK(discount_percentage > 0 AND discount_percentage <= 100),
+    starts_at timestamptz NOT NULL,
+    ends_at timestamptz NOT NULL CHECK(ends_at > starts_at)
+);
+ALTER TABLE alerts ADD COLUMN company_id integer REFERENCES companies(id);
+ALTER TABLE alerts ALTER COLUMN shelf_id DROP NOT NULL;
+CREATE TABLE customer_damage_reports (
+    id uuid PRIMARY KEY,
+    command_id uuid NOT NULL,
+    customer_id integer NOT NULL REFERENCES customers(id),
+    company_id integer NOT NULL REFERENCES companies(id),
+    product_id integer NOT NULL REFERENCES products(id),
+    shelf_id integer REFERENCES shelves(id),
+    problem_type varchar(30) NOT NULL CHECK(problem_type IN ('DAMAGED','TAMPERED','EXPIRED','OTHER')),
+    description varchar(500) NOT NULL DEFAULT '',
+    created_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    alert_id integer UNIQUE REFERENCES alerts(id),
+    UNIQUE(customer_id, command_id)
+);
+CREATE INDEX idx_customer_reports_owner ON customer_damage_reports(customer_id,created_at DESC);
+CREATE TABLE mobile_ai_usage (
+    firebase_uid varchar(128) PRIMARY KEY REFERENCES mobile_identities(firebase_uid),
+    last_started timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+CREATE OR REPLACE FUNCTION create_customer_damage_alert() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE generated_id integer;
+BEGIN
+    -- Validate scope here too: all writers must respect company boundaries.
+    IF NOT EXISTS (SELECT 1 FROM customers WHERE id=NEW.customer_id AND company_id=NEW.company_id)
+       OR NOT EXISTS (SELECT 1 FROM products WHERE id=NEW.product_id AND company_id=NEW.company_id)
+       OR (NEW.shelf_id IS NOT NULL AND NOT EXISTS (
+           SELECT 1 FROM product_shelves ps JOIN shelves sh ON sh.id=ps.shelf_id
+           JOIN aisles a ON a.id=sh.aisle_id JOIN sectors s ON s.id=a.sector_id
+           WHERE ps.product_id=NEW.product_id AND ps.shelf_id=NEW.shelf_id AND s.company_id=NEW.company_id))
+    THEN RAISE EXCEPTION 'Customer report company/location mismatch' USING ERRCODE='23514'; END IF;
+    INSERT INTO alerts(stockout_date,shelf_id,product_id,description,status,company_id)
+    VALUES (CURRENT_DATE,NEW.shelf_id,NEW.product_id,
+        LEFT('Relato de cliente · ' || NEW.problem_type || ': ' || NEW.description,250),'OPEN',NEW.company_id)
+    RETURNING id INTO generated_id;
+    NEW.alert_id := generated_id;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER customer_damage_alert BEFORE INSERT ON customer_damage_reports
+FOR EACH ROW EXECUTE FUNCTION create_customer_damage_alert();
