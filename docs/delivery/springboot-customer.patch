+package com.kairos.kairosapipostgres.mobile;
+
+import org.springframework.web.bind.annotation.*;
+import org.springframework.security.core.Authentication;
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.*;
+import java.util.Map;
+import java.util.List;
+
+@RestController
+@RequestMapping("/api/v1/mobile/customer")
+public class CustomerMobileController {
+    private final CustomerMobileService service;
+    private final ReceiptVisionService vision;
+    public CustomerMobileController(CustomerMobileService service,ReceiptVisionService vision) {
+        this.service=service;
+        this.vision=vision;
+    }
+    public record Image(@NotBlank @Size(max=4194304) String imageBase64) {
+        @Override public String toString() { return "Image[redacted]"; }
+    }
+    @PostMapping("/receipts/interpret")
+    public Map<String,Object> interpret(Authentication auth,@Valid @RequestBody Image request) {
+        return vision.interpret(service.customer(auth),request.imageBase64());
+    }
+    public record Favorite(boolean enabled) { }
+    public record Preview(@NotBlank @Size(max=4096) String qrCode) { }
+    @GetMapping("/home")
+    public Map<String,Object> home(Authentication auth) { return service.home(auth); }
+    @PutMapping("/favorites/{productId}")
+    public Map<String,Object> favorite(Authentication auth,@PathVariable long productId,@RequestBody Favorite request) {
+        service.favorite(service.customer(auth),productId,request.enabled());
+        return Map.of("enabled",request.enabled());
+    }
+    @PostMapping("/receipts/preview")
+    public Map<String,Object> preview(Authentication auth,@Valid @RequestBody Preview request) {
+        return service.preview(service.customer(auth),request.qrCode());
+    }
+    @PostMapping("/receipts")
+    public Map<String,Object> receipt(Authentication auth,@Valid @RequestBody CustomerMobileService.Receipt request) {
+        return service.receipt(service.customer(auth),request);
+    }
+    @GetMapping("/receipts")
+    public List<Map<String,Object>> history(Authentication auth) { return service.history(service.customer(auth)); }
+    @PostMapping("/damage-reports")
+    public Map<String,Object> damage(Authentication auth,@Valid @RequestBody CustomerMobileService.Damage request) {
+        return service.damage(service.customer(auth),request);
+    }
+    @GetMapping("/damage-reports")
+    public List<Map<String,Object>> reports(Authentication auth) { return service.reports(service.customer(auth)); }
+}
diff --git a/src/main/java/com/kairos/kairosapipostgres/mobile/CustomerMobileService.java b/src/main/java/com/kairos/kairosapipostgres/mobile/CustomerMobileService.java
new file mode 100644
index 0000000..4592d4d
--- /dev/null
+++ b/src/main/java/com/kairos/kairosapipostgres/mobile/CustomerMobileService.java
@@ -0,0 +1,181 @@
+package com.kairos.kairosapipostgres.mobile;
+
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.security.access.AccessDeniedException;
+import org.springframework.security.core.Authentication;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+import com.kairos.kairosapipostgres.service.CustomerService;
+import jakarta.validation.constraints.*;
+import jakarta.validation.Valid;
+import java.math.BigDecimal;
+import java.util.*;
+
+@Service
+public class CustomerMobileService {
+    private final JdbcTemplate db;
+    private final CustomerService recommendations;
+    public CustomerMobileService(JdbcTemplate db,CustomerService recommendations) {
+        this.db=db;
+        this.recommendations=recommendations;
+    }
+    public MobileIdentity customer(Authentication auth) {
+        var actor=MobileIdentityService.actor(auth);
+        if (!"CUSTOMER".equals(actor.role()) || actor.customerId()==null || actor.companyId()==null) {
+            throw new AccessDeniedException("Customer required");
+        }
+        return actor;
+    }
+    public void requireProduct(MobileIdentity actor,long product) {
+        if (db.queryForList("SELECT id FROM products WHERE id=? AND company_id=?",product,actor.companyId()).isEmpty()) {
+            throw new AccessDeniedException("Product outside company");
+        }
+    }
+    public Map<String,Object> home(Authentication auth) {
+        var actor=customer(auth);
+        var products=db.queryForList("""
+            SELECT p.id,p.name,COALESCE(p.brand,'') brand,CAST(p.price AS numeric) price,
+            EXISTS(SELECT 1 FROM customer_favorites f WHERE f.customer_id=? AND f.product_id=p.id) favorite
+            FROM products p WHERE p.company_id=? ORDER BY p.name LIMIT 1000
+            """,actor.customerId(),actor.companyId());
+        var locations=db.queryForList("""
+            SELECT ps.product_id,sh.id shelf_id,a.position aisle,s.name sector FROM product_shelves ps
+            JOIN products p ON p.id=ps.product_id JOIN shelves sh ON sh.id=ps.shelf_id
+            JOIN aisles a ON a.id=sh.aisle_id JOIN sectors s ON s.id=a.sector_id
+            WHERE p.company_id=? AND s.company_id=? ORDER BY sh.id
+            """,actor.companyId(),actor.companyId());
+        var offers=db.queryForList("""
+            SELECT o.id,o.product_id,o.kind,o.description,o.discount_percentage FROM customer_offers o
+            JOIN products p ON p.id=o.product_id WHERE p.company_id=?
+            AND o.starts_at<=CURRENT_TIMESTAMP AND o.ends_at>CURRENT_TIMESTAMP ORDER BY o.ends_at LIMIT 100
+            """,actor.companyId());
+        return Map.of("companyId",actor.companyId(),"companyName",actor.companyName(),"products",products,"locations",locations,
+            "offers",offers,"recommendations",recommendations.recommendProducts(actor.customerId(),20,auth),
+            "receipts",history(actor),"reports",reports(actor));
+    }
+    @Transactional
+    public void favorite(MobileIdentity actor,long product,boolean enabled) {
+        requireProduct(actor,product);
+        if (enabled) {
+            db.update("INSERT INTO customer_favorites(customer_id,product_id) VALUES (?,?) ON CONFLICT DO NOTHING",actor.customerId(),product);
+        } else {
+            db.update("DELETE FROM customer_favorites WHERE customer_id=? AND product_id=?",actor.customerId(),product);
+        }
+    }
+    public Map<String,Object> preview(MobileIdentity actor,String qrCode) {
+        String key;
+        try {
+            key=NfceKey.parse(qrCode);
+        } catch (IllegalArgumentException error) {
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,"Chave NFC-e inválida");
+        }
+        var company=db.queryForObject("SELECT cnpj FROM companies WHERE id=?",String.class,actor.companyId());
+        if (company==null || !key.substring(6,20).equals(company.replaceAll("[^0-9]",""))) {
+            throw new ResponseStatusException(HttpStatus.UNPROCESSABLE_ENTITY,"Nota de outro estabelecimento");
+        }
+        return Map.of("accessKey",key,"source","CUSTOMER_CONFIRMED","items",List.of(),
+            "message","Chave identificada. Os itens não estão no QR Code. Confira a nota e informe os produtos, quantidades e valores; a chave não comprova autenticidade fiscal.");
+    }
+    public record Item(@Positive long productId,@Min(1) @Max(100000) int quantity,
+                       @NotNull @DecimalMin("0.00") @DecimalMax("1000000") @Digits(integer=7,fraction=2) BigDecimal amount) { }
+    public record Receipt(@NotBlank @Size(max=4096) String qrCode,
+                          @NotEmpty @Size(max=100) List<@Valid Item> items) { }
+    public record Damage(@NotNull UUID commandId,@Positive long productId,Long shelfId,
+                         @NotBlank @Pattern(regexp="DAMAGED|TAMPERED|EXPIRED|OTHER") String problemType,
+                         @NotNull @Size(max=500) String description) { }
+
+    @Transactional
+    public Map<String,Object> receipt(MobileIdentity actor,Receipt request) {
+        String key=(String)preview(actor,request.qrCode()).get("accessKey");
+        // Serialize per store: deterministic replay and concurrent duplicate protection.
+        db.queryForList("SELECT id FROM companies WHERE id=? FOR UPDATE",actor.companyId());
+        var existing=db.queryForList("SELECT id,customer_id,purchase_id FROM customer_receipts WHERE company_id=? AND access_key=?",actor.companyId(),key);
+        if (!existing.isEmpty()) {
+            var receipt=existing.getFirst();
+            if (((Number)receipt.get("customer_id")).longValue()!=actor.customerId()) {
+                throw new ResponseStatusException(HttpStatus.CONFLICT,"Nota já vinculada");
+            }
+            var persisted=db.queryForList("SELECT product_id,quantity,CAST(amount AS numeric) amount FROM purchase_products WHERE purchase_id=? ORDER BY product_id",receipt.get("purchase_id"));
+            var submitted=request.items().stream().sorted(Comparator.comparingLong(Item::productId)).toList();
+            if (persisted.size()!=submitted.size()) {
+                throw new ResponseStatusException(HttpStatus.CONFLICT,"Nota já confirmada com outros itens");
+            }
+            for (int i=0;i<persisted.size();i++) {
+                var row=persisted.get(i);
+                var item=submitted.get(i);
+                if (((Number)row.get("product_id")).longValue()!=item.productId()
+                    || ((Number)row.get("quantity")).intValue()!=item.quantity()
+                    || new BigDecimal(row.get("amount").toString()).compareTo(item.amount())!=0) {
+                    throw new ResponseStatusException(HttpStatus.CONFLICT,"Nota já confirmada com outros itens");
+                }
+            }
+            return Map.of("protocol",receipt.get("id").toString(),"status","CONFIRMED");
+        }
+        if (request.items().stream().map(Item::productId).distinct().count()!=request.items().size()) {
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,"Agrupe os itens do mesmo produto");
+        }
+        request.items().forEach(item -> requireProduct(actor,item.productId()));
+        Long purchase=db.queryForObject("INSERT INTO purchases(customer_id,date,status) VALUES (?,CURRENT_TIMESTAMP,'COMPLETED') RETURNING id",Long.class,actor.customerId());
+        for (Item item:request.items()) {
+            db.update("INSERT INTO purchase_products(purchase_id,product_id,quantity,amount) VALUES (?,?,?,CAST(? AS money))",
+                purchase,item.productId(),item.quantity(),item.amount());
+        }
+        UUID protocol=UUID.randomUUID();
+        db.update("INSERT INTO customer_receipts(id,customer_id,company_id,access_key,purchase_id,source) VALUES (?,?,?,?,?,'CUSTOMER_CONFIRMED')",
+            protocol,actor.customerId(),actor.companyId(),key,purchase);
+        return Map.of("protocol",protocol.toString(),"status","CONFIRMED");
+    }
+    public List<Map<String,Object>> history(MobileIdentity actor) {
+        var receipts=db.queryForList("""
+            SELECT r.id,r.access_key,r.purchase_id,r.source,CAST(r.confirmed_at AS varchar) confirmed_at,
+            (SELECT SUM(CAST(pp.amount AS numeric)) FROM purchase_products pp WHERE pp.purchase_id=r.purchase_id) total
+            FROM customer_receipts r WHERE r.customer_id=? AND r.company_id=? ORDER BY r.confirmed_at DESC LIMIT 100
+            """,actor.customerId(),actor.companyId());
+        for (var receipt:receipts) {
+            receipt.put("items",db.queryForList("""
+                SELECT pp.product_id,p.name,pp.quantity,CAST(pp.amount AS numeric) amount FROM purchase_products pp
+                JOIN products p ON p.id=pp.product_id WHERE pp.purchase_id=? AND p.company_id=? ORDER BY p.name
+                """,receipt.get("purchase_id"),actor.companyId()));
+        }
+        return receipts;
+    }
+    @Transactional
+    public Map<String,Object> damage(MobileIdentity actor,Damage request) {
+        requireProduct(actor,request.productId());
+        if (request.shelfId()!=null && db.queryForList("""
+            SELECT ps.id FROM product_shelves ps JOIN shelves sh ON sh.id=ps.shelf_id
+            JOIN aisles a ON a.id=sh.aisle_id JOIN sectors s ON s.id=a.sector_id
+            WHERE ps.product_id=? AND ps.shelf_id=? AND s.company_id=?
+            """,request.productId(),request.shelfId(),actor.companyId()).isEmpty()) {
+            throw new AccessDeniedException("Product location mismatch");
+        }
+        db.queryForList("SELECT id FROM customers WHERE id=? FOR UPDATE",actor.customerId());
+        var previous=db.queryForList("SELECT * FROM customer_damage_reports WHERE customer_id=? AND command_id=?",actor.customerId(),request.commandId());
+        if (!previous.isEmpty()) {
+            var row=previous.getFirst();
+            boolean shelfMatches=Objects.equals(row.get("shelf_id")==null?null:((Number)row.get("shelf_id")).longValue(),request.shelfId());
+            if (((Number)row.get("product_id")).longValue()!=request.productId() || !shelfMatches
+                || !row.get("problem_type").equals(request.problemType()) || !row.get("description").equals(request.description().trim())) {
+                throw new ResponseStatusException(HttpStatus.CONFLICT,"Comando já usado");
+            }
+            return Map.of("protocol",row.get("id").toString(),"status","REGISTERED");
+        }
+        UUID protocol=UUID.randomUUID();
+        db.update("""
+            INSERT INTO customer_damage_reports(id,command_id,customer_id,company_id,product_id,shelf_id,problem_type,description)
+            VALUES (?,?,?,?,?,?,?,?)
+            """,protocol,request.commandId(),actor.customerId(),actor.companyId(),request.productId(),request.shelfId(),
+            request.problemType(),request.description().trim());
+        return Map.of("protocol",protocol.toString(),"status","REGISTERED");
+    }
+    public List<Map<String,Object>> reports(MobileIdentity actor) {
+        return db.queryForList("""
+            SELECT r.id,r.product_id,p.name,r.shelf_id,r.problem_type,r.description,
+            CAST(r.created_at AS varchar) created_at,a.status FROM customer_damage_reports r
+            JOIN products p ON p.id=r.product_id JOIN alerts a ON a.id=r.alert_id
+            WHERE r.customer_id=? AND r.company_id=? ORDER BY r.created_at DESC LIMIT 100
+            """,actor.customerId(),actor.companyId());
+    }
+}
