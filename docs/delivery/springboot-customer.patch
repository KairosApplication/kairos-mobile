+        verifyNoInteractions(client,db);
+    }
+    @Test
+    @SuppressWarnings("unchecked")
+    void providerReturnsOnlyUnverifiedSuggestionsWithoutSavingAnyPurchase() throws Exception {
+        var db=mock(JdbcTemplate.class);
