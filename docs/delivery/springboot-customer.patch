@@ -0,0 +1,67 @@
+package com.kairos.kairosapipostgres.mobile;
+
+import org.springframework.web.bind.annotation.*;
+import org.springframework.security.core.Authentication;
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.*;
+import java.time.LocalDate;
+import java.util.*;
+
+@RestController
+@RequestMapping("/api/v1/mobile")
+public class MobileController {
+    private final MobileIdentityService identities;
+    private final MobileOperationalService operations;
+    public MobileController(MobileIdentityService identities,MobileOperationalService operations) {
+        this.identities=identities;
+        this.operations=operations;
+    }
+    public record Link(@NotBlank @Size(max=255) String password) {
+        @Override public String toString() { return "Link[redacted]"; }
+    }
+    public record Registration(@NotBlank @Size(max=100) String name,@NotBlank @Size(max=100) String lastName,
+                               @NotNull @Past LocalDate birthDate,@NotBlank @Size(max=14) @org.hibernate.validator.constraints.br.CPF String cpf) { }
+    public record Batch(@NotEmpty @Size(max=25) List<MobileOperationalService.Restock> items) { }
+    private Map<String,Object> identity(MobileIdentity actor) {
+        if (actor.userId()==null || actor.companyId()==null) {
+            throw new org.springframework.security.access.AccessDeniedException("Business link required");
+        }
+        Map<String,Object> result=new LinkedHashMap<>();
+        result.put("userId",actor.userId());
+        result.put("employeeId",actor.employeeId());
+        result.put("customerId",actor.customerId());
+        result.put("companyId",actor.companyId());
+        result.put("companyName",actor.companyName());
+        result.put("role",actor.role());
+        return result;
+    }
+    @GetMapping("/session")
+    public Map<String,Object> session(Authentication auth) { return identity(MobileIdentityService.actor(auth)); }
+    @PostMapping("/link")
+    public Map<String,Object> link(Authentication auth,@Valid @RequestBody Link request) {
+        return identity(identities.link(MobileIdentityService.actor(auth),request.password()));
+    }
+    @PostMapping("/registration")
+    public Map<String,Object> register(Authentication auth,@Valid @RequestBody Registration request) {
+        return identity(identities.register(MobileIdentityService.actor(auth),request.name(),request.lastName(),request.birthDate(),request.cpf()));
+    }
+    @GetMapping("/catalog")
+    public Map<String,Object> catalog(Authentication auth) { return operations.catalog(MobileIdentityService.actor(auth)); }
+    @GetMapping("/alerts")
+    public List<Map<String,Object>> alerts(Authentication auth) { return operations.alerts(MobileIdentityService.actor(auth)); }
+    @PostMapping("/alerts/{id}/resolve")
+    public Map<String,Object> resolve(Authentication auth,@PathVariable long id) {
+        operations.resolve(MobileIdentityService.actor(auth),id);
+        return Map.of("status","RESOLVED");
+    }
+    @GetMapping("/work-summary")
+    public Map<String,Object> summary(Authentication auth) { return operations.summary(MobileIdentityService.actor(auth)); }
+    @PostMapping("/restockings/registration")
+    public Map<String,Object> restock(Authentication auth,@RequestBody MobileOperationalService.Restock request) {
+        return operations.confirm(MobileIdentityService.actor(auth),request);
+    }
+    @PostMapping("/restockings/batch")
+    public List<Map<String,Object>> batch(Authentication auth,@Valid @RequestBody Batch request) {
+        return operations.batch(MobileIdentityService.actor(auth),request.items());
+    }
+}
diff --git a/src/main/java/com/kairos/kairosapipostgres/mobile/MobileIdentity.java b/src/main/java/com/kairos/kairosapipostgres/mobile/MobileIdentity.java
